rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid && (
        request.resource.data.role == 'auxiliar' || 
        request.resource.data.role == 'coordenador' ||
        request.resource.data.role == 'admin'
      );
      allow update: if request.auth != null && (
        // Admins can update any user's role
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin' ||
        // Users can update their own profile (including switching role for testing/testing-convenience)
        request.auth.uid == uid
      );
      allow delete: if request.auth != null && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    // Config (turmas, etc.)
    match /config/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role in ['admin', 'coordenador'];
    }

    // Registros & Midias
    match /registros/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /midias/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Semanarios & Atividades
    match /semanarios/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Flat Atividades DB for query/index purposes
    match /atividades_db/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
